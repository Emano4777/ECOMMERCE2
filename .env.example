# Copie este arquivo para .env e preencha os valores

# String de conexão Supabase (mesma do pedidoeletronico)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Chave secreta do Flask (mude para produção)
SECRET_KEY=troque-esta-chave-em-producao

# Bluesoft Cosmos: use COSMOS_TOKEN para uma chave ou COSMOS_TOKENS para varias.
# Separe varias chaves por virgula, ponto e virgula, espaco ou quebra de linha.
COSMOS_TOKEN=
COSMOS_TOKENS=

# Serper: use SERPER_API_KEY para uma chave ou SERPER_API_KEYS para fallback.
# Separe varias chaves por virgula, ponto e virgula, espaco ou quebra de linha.
SERPER_API_KEY=
SERPER_API_KEYS=

# Mercado Livre Developers
# Crie um app em https://developers.mercadolivre.com.br/ e preencha:
# - ML_APP_ID: App ID / Client ID da aplicacao
# - ML_CLIENT_SECRET: Client Secret da aplicacao
# O mesmo redirect abaixo precisa estar cadastrado no app do Mercado Livre.
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://ecommerce-2-rosy.vercel.app/ml/callback

# Alpha/A7 base externa
# Use ALPHA_DATABASE_URL ou preencha os campos separados abaixo.
ALPHA_DATABASE_URL=
ALPHA_DB_HOST=
ALPHA_DB_PORT=6543
ALPHA_DB_NAME=postgres
ALPHA_DB_USER=
ALPHA_DB_PASSWORD=
ALPHA_DB_SSLMODE=require
ALPHA_DB_SCHEMA=alpha7
ALPHA_DEFAULT_CNPJLOJA=54185432000143
ALPHA_ACTIVE_CLASSIFICATION=LICENCE FARMA > ATIVO
