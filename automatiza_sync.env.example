# Copie este arquivo para ".env" na MESMA pasta do automatiza_sync.py,
# na maquina da loja de Sao Jose do Rio Preto (onde o Automatiza roda),
# e preencha os valores reais.

# Banco do Automatiza (MySQL local -- so funciona rodando nessa maquina)
AUTOMATIZA_DB_HOST=localhost
AUTOMATIZA_DB_PORT=3306
AUTOMATIZA_DB_USER=delivery
AUTOMATIZA_DB_PASSWORD=Delivery
AUTOMATIZA_DB_SCHEMA=automatiza

# CNPJ da loja no nosso sistema (Poupaqui) -- ja usado como default no
# codigo, mas fica explicito aqui pra facilitar trocar se precisar
AUTOMATIZA_CNPJLOJA=64369730000147

# Banco do Poupaqui (Supabase) -- mesma connection string usada no
# app.py/Vercel, com o pooler liberado pra conexao externa
DATABASE_URL=postgresql://usuario:senha@host:porta/postgres?sslmode=require
